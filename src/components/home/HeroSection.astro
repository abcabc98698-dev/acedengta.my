---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Check, ShieldCheck } from "@lucide/astro";

const nodeMetrics = [
  { region: "香港 IEPL 01", flag: "🇭🇰", type: "原生/2.5G", ping: "16ms", status: "在线" },
  { region: "日本 IEPL 02", flag: "🇯🇵", type: "原生/2.5G", ping: "34ms", status: "在线" },
  { region: "新加坡 IEPL 01", flag: "🇸🇬", type: "原生/2.5G", ping: "42ms", status: "在线" },
  { region: "美国原生 AI 专线", flag: "🇺🇸", type: "原生/2.5G", ping: "125ms", status: "在线" },
];

const highlights = [
  { label: "运营历程", value: "2020 至今", desc: "老牌沉淀稳健运营" },
  { label: "线路架构", value: "IEPL 专线", desc: "企业级内网不卡顿" },
  { label: "单节点速率", value: "2.5 Gbps", desc: "4K/8K 视频秒开" },
  { label: "节点倍率", value: "全节点 ×1.0", desc: "真实流量绝无暗扣" },
];
---

<div class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-32 xl:px-0">
  <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16 gap-10">
    <!-- Left: Brand Copy & CTAs -->
    <div class="relative w-full md:max-w-[540px] md:w-1/2 text-center sm:text-left sm:-mt-8">
      <!-- Feature Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">2020年稳定运营</Badge>
        <Badge variant="accent">企业级 IEPL 专线</Badge>
        <Badge variant="neutral">VLESS 新一代协议</Badge>
        <Badge variant="neutral">不限设备数</Badge>
      </div>

      <!-- Main Headline -->
      <h1 class="mb-4">
        <AnimatedText
          content="灯塔加速器 · 专线极速互联"
          delay={0.1}
          duration={0.5}
          stagger={0.06}
          class="text-3xl text-pri leading-tight md:text-4xl lg:text-5xl font-brand font-bold tracking-tight text-neutral-900 dark:text-white"
        />
      </h1>

      <!-- Value Proposition Subtitle -->
      <div class="mb-8">
        <p
          class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed font-normal"
          data-aos="fade-up-xs"
          data-aos-delay="300"
          data-aos-once="true"
        >
          自 2020 年起稳定运营的老牌综合型网络加速品牌。全节点单节点最高 2.5Gbps，采用企业内网 IEPL 专线与 VLESS 协议。不限客户端在线设备数量，深度解锁 ChatGPT、Claude、Netflix 4K 及 TikTok 跨境出海直播。年付折合约 <strong>8.25元/月</strong>，另享斯诺克 147 永久无忧套餐。
        </p>
      </div>

      <!-- Conversion Buttons -->
      <div
        class="flex flex-wrap gap-4 justify-center sm:justify-start items-center"
        data-aos="fade-up-sm"
        data-aos-delay="500"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button
          url={siteConfig.registerUrl}
          target="_blank"
          type="fill"
          className="shadow-md hover:shadow-lg font-semibold text-base px-6 py-3"
        >
          立即注册使用 <ArrowRight size={17} class="ml-1" />
        </Button>
        <Button
          url="#pricing"
          type="solid"
          className="font-semibold text-base px-5 py-3"
        >
          查看套餐方案
        </Button>
      </div>

      <!-- Trust Pillars -->
      <div
        class="mt-8 pt-6 border-t border-dashed border-neutral-200 dark:border-neutral-700 flex flex-wrap items-center justify-center sm:justify-start gap-y-2 gap-x-5 text-xs text-neutral-500 dark:text-neutral-400"
        data-aos="fade-up-xs"
        data-aos-delay="600"
        data-aos-once="true"
      >
        <span class="inline-flex items-center gap-1.5">
          <Check class="w-4 h-4 text-emerald-500" />
          全系不限设备
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Check class="w-4 h-4 text-emerald-500" />
          自研客户端 + 通用订阅
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Check class="w-4 h-4 text-emerald-500" />
          全节点 ×1.0 无虚假倍率
        </span>
      </div>
    </div>

    <!-- Right: Real-time Live Node Monitor Mockup -->
    <div
      class="relative justify-end w-full md:flex md:w-1/2 md:translate-y-4 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="300"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="app.acedengta.my/network-status" className="w-full shadow-2xl">
        <div class="p-5 md:p-6 flex flex-col gap-4 bg-bg-secondary/90 dark:bg-bg-secondary-dark/90">
          <!-- Monitor Header -->
          <div class="flex items-center justify-between pb-3 border-b border-dashed border-primary/15 dark:border-neutral-700">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">
                灯塔专线健康监控中心 (IEPL Active)
              </span>
            </div>
            <div class="flex items-center gap-2 text-[10px] text-neutral-400">
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono font-medium">99.98% 可用率</span>
            </div>
          </div>

          <!-- Top Metric Cards Grid (2x2) -->
          <div class="grid grid-cols-2 gap-2.5">
            {highlights.map((item) => (
              <div class="p-3 rounded-xl border border-primary/10 dark:border-neutral-700 bg-bg-primary/50 dark:bg-neutral-800/40">
                <span class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-1">
                  {item.label}
                </span>
                <div class="text-sm md:text-base font-bold font-brand text-neutral-900 dark:text-white leading-none">
                  {item.value}
                </div>
                <span class="text-[10px] text-neutral-500 dark:text-neutral-400 mt-1 block">
                  {item.desc}
                </span>
              </div>
            ))}
          </div>

          <!-- Live Nodes Ping List -->
          <div class="space-y-2 mt-1">
            <div class="text-[11px] font-semibold text-neutral-500 dark:text-neutral-400 px-1 flex justify-between">
              <span>高可用热门线路</span>
              <span>时延状态</span>
            </div>
            {nodeMetrics.map((node) => (
              <div class="flex items-center justify-between px-3 py-2 rounded-lg border border-primary/10 dark:border-neutral-700/80 bg-white/70 dark:bg-neutral-800/60 text-xs">
                <div class="flex items-center gap-2.5">
                  <span class="text-base leading-none">{node.flag}</span>
                  <div>
                    <span class="font-medium text-neutral-800 dark:text-neutral-200">{node.region}</span>
                    <span class="ml-2 text-[10px] px-1.5 py-0.2 rounded bg-primary/10 text-primary dark:text-primary-light font-mono">
                      {node.type}
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-2 font-mono">
                  <span class="text-emerald-600 dark:text-emerald-400 font-semibold">{node.ping}</span>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                </div>
              </div>
            ))}
          </div>

          <!-- Bottom Security Bar -->
          <div class="pt-2 flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400">
            <span class="inline-flex items-center gap-1">
              <ShieldCheck class="w-3.5 h-3.5 text-primary" />
              零日志审计 · 端到端 AES-256 加密
            </span>
            <span class="font-mono text-primary font-medium">BGP 多线容灾已就绪</span>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>
