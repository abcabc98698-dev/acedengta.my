---

<section id="pricing" class="pricing-section py-16 md:py-24">
  {showHeader && (
    <div class="site-container" data-aos="fade-up-xs" data-aos-once="true">
      <SectionHeader title={title} description={description} />
    </div>
  )}

  <!-- Pricing Cards Grid -->
  <div class="site-container mt-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {plans.map((plan, i) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 hover:shadow-xl ${
            plan.popular
              ? 'border-primary ring-2 ring-primary/20 bg-bg-secondary dark:bg-bg-secondary-dark shadow-lg lg:-translate-y-2'
              : 'border-primary/15 dark:border-neutral-700 bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 hover:border-primary/40'
          }`}
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          {/* Card Top */}
          <div>
            {/* Badge */}
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border ${plan.badgeColor}`}>
                {plan.popular && <Sparkles class="w-3.5 h-3.5" />}
                {plan.badge}
              </span>
              <span class="text-[11px] font-medium text-neutral-400 dark:text-neutral-500">
                {plan.devices}
              </span>
            </div>

            {/* Plan Name */}
            <h3 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-2">
              {plan.name}
            </h3>

            {/* Positioning Description */}
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-6 min-h-[36px]">
              {plan.positioning}
            </p>

            {/* Price Box */}
            <div class="mb-6 p-4 rounded-xl bg-bg-primary/80 dark:bg-neutral-800/60 border border-dashed border-primary/15 dark:border-neutral-700">
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-bold text-neutral-700 dark:text-neutral-300">{plan.currency}</span>
                <span class="text-4xl font-extrabold font-brand text-neutral-900 dark:text-white leading-none tracking-tight">
                  {plan.price}
                </span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 ml-1.5">
                  / {plan.period}
                </span>
              </div>
              <p class="mt-2 text-xs font-medium text-primary dark:text-primary-light">
                {plan.periodNote}
              </p>
            </div>

            {/* Core specs highlights */}
            <div class="space-y-2.5 pb-6 mb-6 border-b border-dashed border-neutral-200 dark:border-neutral-700 text-xs">
              <div class="flex items-start gap-2 text-neutral-700 dark:text-neutral-300">
                <Zap class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" />
                <span><strong>流量规格：</strong>{plan.traffic}</span>
              </div>
              <div class="flex items-start gap-2 text-neutral-700 dark:text-neutral-300">
                <Server class="w-3.5 h-3.5 text-primary shrink-0 mt-0.5" />
                <span><strong>线路架构：</strong>{plan.line}</span>
              </div>
              <div class="flex items-start gap-2 text-neutral-700 dark:text-neutral-300">
                <Globe class="w-3.5 h-3.5 text-emerald-500 shrink-0 mt-0.5" />
                <span><strong>节点地区：</strong>{plan.nodes}</span>
              </div>
            </div>

            {/* Feature List */}
            <ul class="space-y-2.5 mb-8">
              {plan.features.map((feat) => (
                <li class="flex items-start gap-2 text-xs">
                  <Check class={`w-4 h-4 mt-0.5 shrink-0 ${feat.highlight ? 'text-primary font-bold' : 'text-neutral-400 dark:text-neutral-500'}`} />
                  <span class={`${feat.highlight ? 'text-neutral-800 dark:text-neutral-100 font-semibold' : 'text-neutral-600 dark:text-neutral-400'}`}>
                    {feat.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {/* CTA Button */}
          <div class="pt-2">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              type={plan.popular ? "fill" : "solid"}
              className="w-full justify-center font-semibold text-sm shadow-sm"
            >
              {plan.cta} <ArrowRight size={15} class="ml-1" />
            </Button>
          </div>
        </div>
      ))}
    </div>

    {/* Transparent Pricing Notes & Guarantees */}
    <div
      class="mt-12 p-6 rounded-2xl border border-dashed border-primary/20 bg-primary/5 dark:bg-primary/10 text-center max-w-4xl mx-auto"
      data-aos="fade-up-xs"
      data-aos-delay="200"
      data-aos-once="true"
    >
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-neutral-600 dark:text-neutral-300">
        <span class="inline-flex items-center gap-1.5 font-medium">
          <Shield class="w-4 h-4 text-primary" />
          全系不限制连接设备数
        </span>
        <span class="inline-flex items-center gap-1.5 font-medium">
          <Infinity class="w-4 h-4 text-primary" />
          斯诺克147套餐 247GB 永久不过期
        </span>
        <span class="inline-flex items-center gap-1.5 font-medium">
          <Zap class="w-4 h-4 text-primary" />
          轻量版年付 99元 折算月均仅 8.25元
        </span>
        <span class="inline-flex items-center gap-1.5 font-medium">
          <Cpu class="w-4 h-4 text-primary" />
          极速版享阶梯折扣：年付8折 / 两年75折 / 三年7折
        </span>
      </div>
      <p class="mt-3 text-[11px] text-neutral-400 dark:text-neutral-500">
        所有线路均经由官方自动化高可用监控。如需定制超大带宽或独立企业级原生 IP 专线，可在注册后发起工单与技术团队沟通。
      </p>
    </div>
  </div>
</section>
