      { text: "247GB 永久总流量，无到期时间", highlight: true },
      { text: "不限制登录设备数，全家共用", highlight: false },
      { text: "单节点最高 2.5Gbps 物理速率", highlight: false },
      { text: "全球热门地区覆盖（港/台/日/新/美等）", highlight: false },
      { text: "支持跨境电商与主流海外社媒", highlight: false },
      { text: "一次付费，永久免受月付续费困扰", highlight: true },
    ],
  },
  {
    id: "lightweight",
    name: "轻量版",
    badge: "年付性价比首选",
    badgeColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30",
    price: "99",
    currency: "¥",
    period: "年付特惠",
    periodNote: "折合平均仅 8.25 元/月",
    traffic: "69GB / 月（每月自动重置）",
    positioning: "高性价比日常科学上网入门，轻度使用与学生白领推荐",
    line: "原生稳定优质节点",
    devices: "不限设备数量",
    nodes: "港 / 台 / 日 / 新 / 马 / 美 / 德 / 法 / 英 / 土 / 越",
    suitable: "日常办公、资料查阅、聊天通讯、轻度流媒体",
    unlock: "Netflix / Disney+ / ChatGPT / TikTok",
    discount: "年付超值方案（月均仅 8.25 元）",
    popular: false,
    cta: "立即开通轻量版",
    features: [
      { text: "69GB/月 充沛流量，每月自动刷新", highlight: false },
      { text: "折算平均仅 8.25 元/月，超低使用成本", highlight: true },
      { text: "全设备客户端支持，不限在线设备", highlight: false },
      { text: "覆盖主流亚欧美11+国家与地区节点", highlight: false },
      { text: "解锁 ChatGPT 及主流流媒体内容", highlight: false },
      { text: "VLESS 高效传输协议支持", highlight: false },
    ],
  },
  {
    id: "speed",
    name: "极速版",
    badge: "🔥 站长热销推荐",
    badgeColor: "bg-primary text-white border-primary",
    price: "25",
    currency: "¥",
    period: "月付套餐",
    periodNote: "半年9折 / 年付8折 / 两年75折 / 三年7折",
    traffic: "168GB / 月（高速专线流量）",
    positioning: "晚高峰极速无拥堵，全节点 ×1 倍率，追求高品质体验首选",
