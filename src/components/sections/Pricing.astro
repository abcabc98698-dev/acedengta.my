      { text: "专属分配独享原生 IP 与独立物理带宽", highlight: true },
      { text: "全 IPLC 企业内网专线，物理级网络隔离", highlight: true },
      { text: "500GB/月 专享流量，支持大流量灵活扩容", highlight: false },
      { text: "单节点最高 2.5Gbps，满足高画质多路直播", highlight: false },
      { text: "支持指定全球任意地区线路与网络拓扑", highlight: false },
      { text: "7×24 小时专席技术顾问 1 对 1 贴身支持", highlight: true },
    ],
  },
