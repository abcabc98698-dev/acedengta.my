---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import {
  Zap, Shield, Globe, Cpu, Smartphone, Sparkles,
  ArrowRight, Check
} from "@lucide/astro";

const featureModules = [
  {
    icon: Zap,
    title: "企业级 IEPL / IPLC 纯内网专线",
    desc: "灯塔加速器主干链路直接接入企业级 IEPL 内网专线，数据包经由专有海底光缆传输，物理级直连，不经过公网 GFW。彻底告别传统直连机场高丢包、高抖动与断连困扰。",
    points: [
      "物理专线内网直连，延迟比公网直连降低 60%",
      "晚高峰黄金时段不拥堵，丢包率稳定趋近于 0",
      "全节点保持真实 ×1.0 结算倍率，杜绝虚假计费",
      "单节点物理承载最高达 2.5 Gbps 充沛带宽",
    ],
    direction: "left",
    tag: "核心专线架构",
  },
  {
    icon: Cpu,
    title: "新一代 VLESS 现代化传输协议",
    desc: "全面拥抱 VLESS 新一代轻量化高效协议。剔除传统协议多余的冗余握手开销，具备更强的抗主动探测与自适应伪装能力，在大规模网络审查下依然保持超强生存能力与稳定性。",
    points: [
      "极低 CPU 与内存占用，手机与路由器端更省电",
      "支持自适应流量伪装，抗深度包检测（DPI）",
      "连接握手仅需 1 次往返，首包响应速度极快",
      "全平台客户端深度适配，协议握手平滑顺畅",
    ],
    direction: "right",
    tag: "抗封锁前沿技术",
  },
  {
    icon: Globe,
    title: "全球 70+ 核心机房与原生 IP 矩阵",
    desc: "精选全球顶级数据中心，深度覆盖香港（20+节点）、台湾（5+节点）、日本（10+节点）、新加坡（10+节点）、美国（10+节点）、马来西亚（2+节点）及欧洲多国（英/法/德/土/泰/巴/越等）。",
    points: [
      "高纯净度原生广播 IP，有效避免滥用黑名单",
      "完美支持跨境电商平台与多店铺防关联登录",
      "支持 TikTok 商业直播与短视频推流专线",
      "智能多入口 BGP 调度，自动分流就近接入",
    ],
    direction: "left",
    tag: "全球资源覆盖",
  },
  {
    icon: Sparkles,
    title: "AI 生产力工具与流媒体全域解锁",
    desc: "全线节点针对主流前沿 AI 模型平台及全球流媒体服务进行针对性规则分流与原生 IP 池化保活，保障每一次交互均能畅快秒开。",
    points: [
      "深度解锁 ChatGPT、Claude 3.5 Sonnet、Midjourney、Copilot",
      "全方位支持 Netflix、Disney+、YouTube 4K/8K 极致秒开",
      "支持 Spotify、HBO Max、BBC iPlayer 等区域流媒体",
      "DNS 智能防污染解析，彻底告别 IP 风险拦截提示",
    ],
    direction: "right",
    tag: "业务解锁保证",
  },
  {
    icon: Smartphone,
    title: "自研客户端 + 通用第三方订阅全面兼容",
    desc: "灯塔加速器提供界面直观的专属自研客户端，同时无缝支持市面主流的第三方网络工具一键订阅导入，满足极客与新手的双重诉求。",
    points: [
      "提供极简自研客户端，下载登录一键连接",
      "全面支持 Clash、Shadowrocket（小火箭）、Sing-box、v2rayN",
      "支持智能规则分流，国内直连、海外加速互不干扰",
      "全系所有套餐均不限制登录与在线设备数量",
    ],
    direction: "left",
    tag: "客户端生态",
  },
  {
    icon: Shield,
    title: "7×24 小时高可用自动化容灾与零日志",
    desc: "自 2020 年运营至今，灯塔加速器建立了严苛的自动化节点健康巡检机制。任意机房故障均能在 30 秒内完成智能切换，并严格恪守无日志隐私准则。",
    points: [
      "自研秒级健康探测系统，故障节点自动隔离剔除",
      "全链路高强度对称加密，保障数据传输绝对私密",
      "严格执行无用户连接日志审计策略，捍卫隐私安全",
      "专业技术运维团队全天候待命保障骨干网平稳运行",
    ],
    direction: "right",
    tag: "高可用性保障",
  },
];
---

<Layout
  title="专线优势与网络架构 — 灯塔加速器官网"
  description="灯塔加速器企业级 IEPL 内网专线、新一代 VLESS 协议、单节点最高 2.5Gbps 带宽及全球 70+ 原生节点详细技术规格。不限设备数量，4K/8K秒开，深度解锁 ChatGPT 与 TikTok 跨境出海。"
  keywords="IEPL专线特点, VLESS协议优势, 机场节点分布, 灯塔加速器专线, 原生IP节点, 4K流媒体加速"
>
  <!-- Page Header -->
  <section class="site-container my-12">
    <PageHeader
      title="专线技术与全球网络架构"
      description="五年沉淀，专注品质线路。采用企业级内网 IEPL 专线与新一代 VLESS 协议，全节点 ×1.0 真实倍率，赋能全球数字化互联。"
    />
  </section>

  <!-- Detailed Feature Modules -->
  <section class="site-container pb-20">
    <div class="space-y-16 md:space-y-24">
      {featureModules.map((mod, i) => (
        <div
          class={`flex flex-col gap-8 md:gap-12 lg:items-center ${
            mod.direction === 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row'
          }`}
          data-aos="fade-up-xs"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          {/* Text Content */}
          <div class="flex-1 max-w-xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-3">
              <Sparkles class="w-3.5 h-3.5" /> {mod.tag}
            </span>
            <h2 class="text-2xl md:text-3xl font-brand font-bold text-neutral-900 dark:text-white mb-4">
              {mod.title}
            </h2>
            <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
              {mod.desc}
            </p>
            <ul class="space-y-2.5">
              {mod.points.map((pt) => (
                <li class="flex items-start gap-2.5 text-xs md:text-sm text-neutral-700 dark:text-neutral-300">
                  <Check class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Visual Showcase Card */}
          <div class="flex-1 max-w-xl w-full">
            <div class="p-6 md:p-8 rounded-3xl border border-primary/15 bg-bg-secondary dark:bg-bg-secondary-dark shadow-md">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                  <mod.icon class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-neutral-900 dark:text-white">{mod.title}</h3>
                  <span class="text-xs text-neutral-400">AceDengta Network Infrastructure</span>
                </div>
              </div>
              <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/60 border border-dashed border-primary/20 text-xs font-mono space-y-2">
                <div class="flex justify-between text-neutral-500">
                  <span>Routing Protocol:</span>
                  <span class="text-primary font-semibold">Enterprise IEPL / BGP Dual-Hop</span>
                </div>
                <div class="flex justify-between text-neutral-500">
                  <span>Transport Encryption:</span>
                  <span class="text-emerald-500 font-semibold">VLESS + XTLS Vision Direct</span>
                </div>
                <div class="flex justify-between text-neutral-500">
                  <span>Bandwidth Capacity:</span>
                  <span class="text-neutral-700 dark:text-neutral-200">2.5 Gbps / Dedicated Peak</span>
                </div>
                <div class="flex justify-between text-neutral-500">
                  <span>Traffic Multiplier:</span>
                  <span class="text-primary font-semibold">×1.0 Real-time Standard</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA Strip -->
  <section class="py-16 site-container text-center border-t border-dashed border-neutral-200 dark:border-neutral-700">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-brand font-bold text-neutral-900 dark:text-white mb-4">
        体验真正的企业级专线加速
      </h2>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-8">
        全系套餐均享 IEPL 专线骨干网，不限设备在线数量。立即加入，开启丝滑网络体验。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button
          url={siteConfig.registerUrl}
          target="_blank"
          type="fill"
          className="font-semibold text-base px-8 py-3"
        >
          立即注册选购 <ArrowRight size={17} class="ml-1" />
        </Button>
        <Button
          url="/pricing"
          type="solid"
          className="font-semibold text-base px-6 py-3"
        >
          查看套餐资费
        </Button>
      </div>
    </div>
  </section>
</Layout>
