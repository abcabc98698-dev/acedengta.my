---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import { getCollection, render } from "astro:content";
import Badge from "@/components/ui/Badge.astro";

const allEntries = await getCollection("changelog");
const entries = allEntries.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="服务状态与网络维护公告 — 灯塔加速器官网"
  description="实时查看灯塔加速器骨干专线运行健康度、节点维护扩容日志及官方系统公告。自 2020 年起稳定运营，保持 99.9% 稳定在线率。"
  keywords="灯塔加速器服务状态, 机场节点状态, IEPL线路维护, 专线可用率公告"
>
  <section class="site-container my-12">
    <PageHeader
      title="网络运行状态与更新公告"
      description="实时追踪灯塔加速器骨干专线扩容、节点优化及系统维护动态。自 2020 年起保持 99.9% 稳定在线率。"
    />

    <!-- Real-time Status Card -->
    <div class="mt-8 p-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/5 dark:bg-emerald-500/10 max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <div>
          <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-1.5">
            全线 IEPL / IPLC 专线网络运转正常
          </h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
            香港、日本、新加坡、美国等 70+ 全球节点均处于高可用稳定在线状态
          </p>
        </div>
      </div>
      <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 shrink-0">
        在线率 99.98%
      </span>
    </div>
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <div class="relative">
      <div class="absolute left-4 md:left-6 top-0 bottom-0 w-px bg-neutral-200 dark:bg-neutral-700"></div>

      <div class="space-y-12">
        {entries.map(async (entry, i) => {
          const { Content } = await render(entry);
          return (
            <div
              class="relative pl-12 md:pl-16"
              data-aos="fade-up-sm"
              data-aos-delay={i * 80}
              data-aos-once="true"
            >
              <div class="absolute left-2.5 md:left-4.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>

              <div class="mb-2 flex items-center gap-3 flex-wrap">
                {entry.data.version && (
                  <Badge variant="primary" size="sm">{entry.data.version}</Badge>
                )}
                <time class="text-sm text-neutral-400 dark:text-neutral-500">
                  {formatDate(entry.data.publishDate)}
                </time>
              </div>

              <h2 class="text-xl font-brand font-bold text-neutral-900 dark:text-white mb-2">
                {entry.data.title}
              </h2>

              {entry.data.description && (
                <p class="text-sm text-neutral-600 dark:text-neutral-300 mb-4 leading-relaxed">
                  {entry.data.description}
                </p>
              )}

              <div class="article-content text-xs md:text-sm text-neutral-600 dark:text-neutral-400 border-t border-dashed border-neutral-200 dark:border-neutral-700 pt-3">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
