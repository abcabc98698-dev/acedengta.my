---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout
  title="客户端配置教程与出海指南 — 灯塔加速器官网"
  description="灯塔加速器官方使用教程与技术知识库。包含 Shadowrocket 小火箭导入、Clash Verge 电脑配置、ChatGPT/Claude 专属节点设置及 TikTok 跨境直播网络环境搭建指南。"
  keywords="小火箭教程, Clash教程, 机场订阅导入教程, ChatGPT封号解决, TikTok直播专线配置"
  type="collection"
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="客户端配置指南与知识库"
      description="详尽的图文配置步骤，助您轻松在 iOS、Android、Windows、macOS 上导入灯塔加速器专线订阅。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-12">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
