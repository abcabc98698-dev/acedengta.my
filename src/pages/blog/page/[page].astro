---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 6;
  const posts = await getCollection('post');
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: page.toString() },
      props: { page: page.toString() }
    };
  });
}

const { page } = Astro.props;
const currentPage = parseInt(page);

if (currentPage === 1) {
  return Astro.redirect("/blog/", 301);
}
---

<Layout
  title={`客户端配置教程与出海指南 (第 ${currentPage} 页) — 灯塔加速器官网`}
  description="灯塔加速器官方使用教程与技术知识库。包含 Shadowrocket、Clash、ChatGPT 及 TikTok 专线配置。"
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="客户端配置指南与知识库"
      description="详尽的图文配置步骤，助您轻松在各平台导入灯塔加速器专线订阅。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 px-7 lg:px-0">
    <div class="mt-12">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={6}
      />
    </div>
  </section>
</Layout>
