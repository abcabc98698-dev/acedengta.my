---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, ShieldCheck, Cpu, Users, Zap } from "@lucide/astro";

const timeline = [
  {
    year: "2020 年",
    title: "品牌创立与专线搭建",
    desc: "灯塔加速器正式启动运营。首期接入高规格企业内网中转专线，确立了【全节点 ×1.0 真实倍率】与【不限设备数量】的核心运营准则。",
  },
  {
    year: "2022 年",
    title: "全面升级 IEPL 专线主干",
    desc: "完成骨干网络物理 IEPL 专线重构，彻底绕过公网 GFW 防火墙。大幅降低晚高峰丢包与抖动，4K 超高清流媒体秒开率突破 99%。",
  },
  {
    year: "2024 年",
    title: "拥抱 VLESS 与自研生态",
    desc: "全节点平滑引入新一代 VLESS 强抗封锁协议，并推出专属自研极简客户端，同时深度优化 ChatGPT / Claude 等全球 AI 工具的原生 IP 池。",
  },
  {
    year: "2026 年",
    title: "斯诺克147永久套餐与全球拓扑",
    desc: "正式上线致敬斯诺克 147 永久无忧套餐及年付月均 8.25 元轻量方案，全球高质节点覆盖扩充至 70+，服务全球数以万计的个人与企业出海团队。",
  },
];

const coreValues = [
  {
    icon: Zap,
    title: "专线品质，真实倍率",
    desc: "不以牺牲稳定性的低质廉价公网充当专线，全节点执行真实 ×1.0 结算倍率，杜绝暗扣行为。"
  },
  {
    icon: ShieldCheck,
    title: "严格零日志与隐私捍卫",
    desc: "全链路端到端高强度加密，系统不记录任何用户的访问目标与元数据，真正保障数字隐私安全。"
  },
  {
    icon: Cpu,
    title: "技术驱动，前沿协议",
    desc: "持续跟进 VLESS 及前沿传输优化方案，结合自研自动化网络探针，实现秒级容灾与平滑分流。"
  },
  {
    icon: Users,
    title: "全系无限制共享理念",
    desc: "所有套餐均支持多客户端、多设备同时在线，让个人、家庭与小微出海团队免受多设备加价烦恼。"
  },
];
---

<Layout
  title="关于我们 — 灯塔加速器官网"
  description="了解灯塔加速器（AceDengta）：自 2020 年稳定运营至今的老牌综合型网络服务商。秉持官方授权直营理念，主打企业级 IEPL 专线、VLESS 协议与全系不限设备数量，为全球用户提供长久、可信、高速的互联保障。"
  keywords="灯塔加速器关于, 灯塔机场背景, IEPL专线机场, 2020老牌机场, 科学上网品牌"
>
  <!-- Page Header -->
  <section class="site-container my-12">
    <PageHeader
      title="关于灯塔加速器"
      description="自 2020 年起稳定运营，专注企业级 IEPL 内网专线与 VLESS 协议。为全球用户提供长久、可信赖的高速网络加速服务。"
    />
  </section>

  <!-- Brand Story & Mission -->
  <section class="site-container max-w-3xl mx-auto pb-20">
    <article class="space-y-12">

      <!-- Official Authorization & Identity -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <div class="p-6 rounded-2xl border border-dashed border-primary/30 bg-primary/5 dark:bg-primary/10 mb-8">
          <div class="flex items-center gap-2 text-primary font-bold text-sm mb-2">
            <ShieldCheck class="w-5 h-5" />
            <span>官方正版授权 · 直营服务保障</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
            本站点属于【灯塔加速器】官方品牌直营落地页与授权服务窗口。我们致力于为出海企业、科研学术人员、跨境电商卖家及广大数字游民提供独立、透明、可信的专线加速服务。
          </p>
        </div>

        <h2 class="text-2xl md:text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-100 mb-4">
          我们的初心与品牌定位
        </h2>
        <div class="space-y-4 text-sm md:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            市面上的翻墙与网络加速服务往往处于两极分化：要么是低价拼车、公网严重超卖的劣质“月抛”机场，动辄在晚高峰断流甚至跑路；要么是按设备数严苛限制、定价虚高的企业级专线。
          </p>
          <p>
            <strong>灯塔加速器（AceDengta）</strong>自 2020 年创立之初，便确立了差异化的核心基调：<strong>老牌综合型品质定位</strong>。我们不单纯追求业内最低的虚幻价格，而是把资源聚焦在<strong>企业级 IEPL 内网专线、新一代 VLESS 协议的深度应用、全系不限设备数量</strong>以及长久平稳的日常综合体验。
          </p>
          <p>
            无论是日常查阅资料、流媒体 4K 追剧，还是跨国 TikTok 直播带货、高频 ChatGPT/Claude 对话，灯塔加速器都旨在成为您接入全球数字世界时那一座持久、明亮、安心的灯塔。
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Core Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand font-bold text-neutral-900 dark:text-neutral-100 mb-6">
          我们坚持的四项基本准则
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {coreValues.map((v) => (
            <div class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 shadow-sm">
              <v.icon class="w-6 h-6 text-primary mb-3" />
              <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                {v.title}
              </h3>
              <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
                {v.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Development Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand font-bold text-neutral-900 dark:text-neutral-100 mb-6">
          五年稳健运营历程（2020 - 2026）
        </h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-2 bottom-2 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3">
                  <Badge variant="primary" size="sm">{item.year}</Badge>
                </div>
                <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Conversion Box -->
      <div class="text-center pt-4" data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h3 class="text-xl font-brand font-bold text-neutral-900 dark:text-white mb-3">
          选择值得托付的老牌专线服务商
        </h3>
        <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mb-6">
          立即开通账号，支持轻量版（8.25元/月）、极速专线版及斯诺克 147 永久套餐。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button url={siteConfig.registerUrl} target="_blank" type="fill" className="font-semibold px-8 py-3">
            立即注册官方账号 <ArrowRight size={16} class="ml-1" />
          </Button>
          <Button url="/pricing" type="solid" className="font-semibold px-6 py-3">
            浏览套餐方案
          </Button>
        </div>
      </div>

    </article>
  </section>
</Layout>
