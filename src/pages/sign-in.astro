---
import { ArrowRight, Check, ShieldCheck, Zap, Globe, Sparkles } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="登录官方控制台 — 灯塔加速器官网"
  description="登录灯塔加速器官方用户控制台，管理您的节点订阅、查看剩余流量明细及获取最新自研客户端与节点列表。"
  keywords="灯塔加速器登录, 灯塔机场控制台, 科学上网管理, 订阅链接获取"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(400px,1fr)]">
      {/* Left Column */}
      <div data-aos="fade-up-xs" data-aos-once="true">
        <div class="max-w-lg">
          <p class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary">
            <Sparkles size={13} /> 客户专属控制台
          </p>
          <h1 class="font-brand text-3xl md:text-5xl font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">
            登录灯塔加速器，管理您的专线订阅
          </h1>
          <p class="mt-4 text-sm md:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            在官方控制台一键复制通用订阅链接、下载自研客户端、查看实时线路状态或选购续费方案。
          </p>
        </div>

        <div class="mt-8 space-y-4 max-w-lg border-y border-dashed border-neutral-200 py-6 dark:border-neutral-700">
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">一键导入所有客户端</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">控制台支持一键导入 Clash、Shadowrocket、Sing-box、v2rayN 等。</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">7×24 小时在线工单支持</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">遇到任何技术难题，直接发起客服工单即可获得极速响应。</p>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-neutral-400 dark:text-neutral-500">
          还没有账号？<a href={siteConfig.registerUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" class="text-primary hover:underline font-semibold">立即注册新账号</a>
        </p>
      </div>

      {/* Right Action Card */}
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <div class="rounded-3xl border border-primary/25 bg-bg-secondary dark:bg-bg-secondary-dark p-8 md:p-10 shadow-2xl text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
            <ShieldCheck class="w-8 h-8" />
          </div>

          <h2 class="text-2xl font-brand font-bold text-neutral-900 dark:text-white mb-2">
            前往官方控制台登录
          </h2>
          <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mb-8 max-w-sm mx-auto leading-relaxed">
            点击下方按钮前往灯塔加速器官方授权登录端口。
          </p>

          <Button
            url={siteConfig.loginUrl}
            target="_blank"
            type="fill"
            className="w-full justify-center font-bold text-base py-4 shadow-lg mb-4"
          >
            立即前往官方控制台登录 <ArrowRight size={18} class="ml-1.5" />
          </Button>

          <div class="pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700 flex items-center justify-center gap-4 text-xs text-neutral-400">
            <span class="inline-flex items-center gap-1">
              <Zap size={14} class="text-amber-500" /> 企业级 IEPL 专线
            </span>
            <span class="inline-flex items-center gap-1">
              <Globe size={14} class="text-primary" /> 全系不限设备
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
