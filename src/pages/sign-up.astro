---
import { ArrowRight, Check, ShieldCheck, Zap, Globe, Sparkles } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="注册官方账号 — 灯塔加速器官网"
  description="立即注册灯塔加速器官方授权账号，开通企业级 IEPL 专线，畅享极速稳定的全球互联体验。不限设备数量，年付平均仅需 8.25 元/月，另享斯诺克 147 永久套餐。"
  keywords="灯塔加速器注册, 灯塔机场注册, 科学上网开通, 翻墙机场账号"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(400px,1fr)]">
      {/* Left Benefits Column */}
      <div data-aos="fade-up-xs" data-aos-once="true">
        <div class="max-w-lg">
          <p class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary">
            <Sparkles size={13} /> 官方授权注册通道
          </p>
          <h1 class="font-brand text-3xl md:text-5xl font-bold leading-tight tracking-tight text-neutral-900 dark:text-white">
            10 秒完成注册，立即畅享企业级专线加速
          </h1>
          <p class="mt-4 text-sm md:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
            欢迎加入自 2020 年稳定运营的灯塔加速器。全节点单节点最高 2.5Gbps，真实 ×1.0 倍率，不限制登录设备数。
          </p>
        </div>

        <div class="mt-8 space-y-4 max-w-lg border-y border-dashed border-neutral-200 py-6 dark:border-neutral-700">
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">高性价比入门与永久备用</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">轻量版年付平均仅需 8.25 元/月；致敬斯诺克 147 永久套餐 247GB 永不过期。</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">企业级 IEPL 专线，晚高峰无忧</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">物理专线不过 GFW，超低时延与丢包，4K/8K 极致秒开。</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Check class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
            <div>
              <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">全系全设备不限连接</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">一个订阅在电脑、手机、平板、软路由等所有设备间自由共享。</p>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-neutral-400 dark:text-neutral-500">
          已有账号？<a href={siteConfig.loginUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" class="text-primary hover:underline font-semibold">直接登录控制台</a>
        </p>
      </div>

      {/* Right Conversion Card */}
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <div class="rounded-3xl border border-primary/25 bg-bg-secondary dark:bg-bg-secondary-dark p-8 md:p-10 shadow-2xl text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
            <Zap class="w-8 h-8" />
          </div>

          <h2 class="text-2xl font-brand font-bold text-neutral-900 dark:text-white mb-2">
            前往官方控制台完成注册
          </h2>
          <p class="text-xs md:text-sm text-neutral-500 dark:text-neutral-400 mb-8 max-w-sm mx-auto leading-relaxed">
            点击下方按钮前往灯塔加速器官方授权接入端口，仅需邮箱即可快速完成注册与套餐开通。
          </p>

          <Button
            url={siteConfig.registerUrl}
            target="_blank"
            type="fill"
            className="w-full justify-center font-bold text-base py-4 shadow-lg mb-4"
          >
            立即前往官方授权注册 <ArrowRight size={18} class="ml-1.5" />
          </Button>

          <div class="pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700 flex items-center justify-center gap-4 text-xs text-neutral-400">
            <span class="inline-flex items-center gap-1">
              <ShieldCheck size={14} class="text-emerald-500" /> 官方正版授权
            </span>
            <span class="inline-flex items-center gap-1">
              <Globe size={14} class="text-primary" /> 全球 70+ 专线节点
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
