---
import { siteConfig } from '@/config/site.js';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  url?: string;
  ogImage?: string;
  twitterHandle?: string;
  type?: 'website' | 'article' | 'collection';
  publishDate?: Date;
  dateModified?: Date;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description = siteConfig.meta.description,
  keywords = siteConfig.meta.keywords,
  ogImage = siteConfig.meta.image || '/og.jpg',
  twitterHandle = siteConfig.social.twitterName || 'acedengta',
  type = 'website',
  publishDate,
  dateModified,
  faq,
} = Astro.props;

// Determine page title
const pageTitle = title
  ? (title.includes(siteConfig.title) ? title : `${title} — ${siteConfig.title}`)
  : siteConfig.meta.title;

// Canonical URL calculation (ensures clean absolute URL)
const siteBase = Astro.site || new URL(siteConfig.url);
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

// Ensure absolute image URL for OG and Twitter
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteBase).href;

// JSON-LD Structured Data
const jsonLdWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': siteConfig.title,
  'url': siteConfig.url,
  'description': siteConfig.meta.description,
  'publisher': {
    '@type': 'Organization',
    'name': siteConfig.author,
    'url': siteConfig.url,
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/logo.png', siteBase).href,
    },
  },
};

const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': siteConfig.title,
  'alternateName': siteConfig.nameEn,
  'url': siteConfig.url,
  'logo': {
    '@type': 'ImageObject',
    'url': new URL('/logo.png', siteBase).href,
  },
  'sameAs': [
    siteConfig.social?.twitter,
    siteConfig.social?.telegram,
  ].filter(Boolean),
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': siteConfig.mail,
    'contactType': 'customer support',
  },
};

// 3-tier Breadcrumb hierarchy calculation
const pathname = Astro.url.pathname;
const isHome = canonicalURL === siteConfig.url || canonicalURL === `${siteConfig.url}/`;
const isBlogSub = pathname.startsWith('/blog/') && pathname !== '/blog/' && pathname !== '/blog';

const breadcrumbItems: Array<{ '@type': string; position: number; name: string; item: string }> = [
  {
    '@type': 'ListItem',
    'position': 1,
    'name': '首页',
    'item': siteConfig.url,
  },
];

if (isBlogSub) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': '配置教程与知识库',
    'item': `${siteConfig.url}/blog/`,
  });
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 3,
    'name': pageTitle,
    'item': canonicalURL,
  });
} else if (!isHome) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': pageTitle,
    'item': canonicalURL,
  });
}

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems,
};

const jsonLdCollection = (type === 'collection' || pathname === '/blog/' || pathname === '/blog') ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': pageTitle,
  'description': description,
  'url': canonicalURL,
} : null;

const jsonLdArticle = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title || pageTitle,
  'description': description,
  'image': absoluteOgImage,
  'datePublished': publishDate ? publishDate.toISOString() : undefined,
  'dateModified': (dateModified || publishDate) ? (dateModified || publishDate)!.toISOString() : undefined,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  'author': {
    '@type': 'Organization',
    'name': siteConfig.author,
    'url': siteConfig.url,
  },
  'publisher': {
    '@type': 'Organization',
    'name': siteConfig.author,
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/logo.png', siteBase).href,
    },
  },
} : null;

const jsonLdFaq = (faq && faq.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faq.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer.replace(/<[^>]*>?/gm, '').trim(),
    },
  })),
} : null;
---

<!-- Core Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Canonical Link -->
<link rel="canonical" href={canonicalURL} />

<!-- Search Engine Site Verifications (Google, Bing, Baidu, Shenma) -->
{siteConfig.verification?.google && (
  <meta name="google-site-verification" content={siteConfig.verification.google} />
)}
{siteConfig.verification?.bing && (
  <meta name="msvalidate.01" content={siteConfig.verification.bing} />
)}
{siteConfig.verification?.baidu && (
  <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />
)}
{siteConfig.verification?.shenma && (
  <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />
)}

<!-- Open Graph Meta Tags -->
<meta property="og:type" content={type === 'collection' ? 'website' : type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content="zh_CN" />
{type === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{type === 'article' && (dateModified || publishDate) && (
  <meta property="article:modified_time" content={(dateModified || publishDate)!.toISOString()} />
)}
{type === 'article' && siteConfig.author && (
  <meta property="article:author" content={siteConfig.author} />
)}

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:site" content={twitterHandle.startsWith('@') ? twitterHandle : `@${twitterHandle}`} />
<meta name="twitter:creator" content={twitterHandle.startsWith('@') ? twitterHandle : `@${twitterHandle}`} />

<!-- Feed & Sitemap Discovery -->
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="sitemap" href="/sitemap.xml" />

<!-- Favicon and App Icons -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<!-- JSON-LD Structured Data for SEO -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
{jsonLdCollection && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdCollection)} />
)}
{jsonLdArticle && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
)}
{jsonLdFaq && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
)}
